rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User pointer doc and old data path — only the user themselves can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // THE FOUNDER — the one account allowed to hand someone a whole new company
    // (a `newOrg` invite, see below). Deliberately a hardcoded email rather than
    // a role: an admin is admin OF AN ORG, and a new company's owner is an admin
    // too, so keying this on a role would let every company you start spawn
    // further companies without limit. Change this string to move the power.
    function isFounder() {
      return request.auth != null && request.auth.token.email != null &&
        request.auth.token.email.lower() == 'davor.demic@gmail.com';
    }

    // Invite lookup — readable by any authenticated user (needed at sign-in).
    // Two kinds of row live here:
    //   · a JOIN invite  — { orgId, role, email }: sign in and you become a
    //     member of that org with that role. Written only by an admin OF THAT
    //     ORG; this is the trust anchor for invite-only membership and must
    //     never be world-writable.
    //   · a FOUNDER invite — { kind: 'newOrg', email, companyName, newOrgId,
    //     expiresAt, issuedByOrg, issuedBy }: sign in and a BRAND NEW org is
    //     created with you as its admin. The org's id is PRE-ALLOCATED on the
    //     invite (newOrgId), so the invite can create that one org and nothing
    //     else; expiresAt is epoch millis, after which it is dead.
    //     Only the founder account may write one.
    // Deleted by the invited user (accepting) or by whoever could have issued it.
    match /inviteLookup/{emailKey} {
      function isAdminOf(orgId) {
        return request.auth != null &&
          get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
      }
      function isOwnEmailKey() {
        return request.auth != null && request.auth.token.email != null &&
          emailKey == request.auth.token.email.lower().replace('\\.', ',');
      }
      function isNewOrgRow(data) { return data.get('kind', '') == 'newOrg'; }
      allow read: if request.auth != null;
      // .get(key, default) throughout: a founder row carries no orgId and a
      // join row carries no kind, so reading either field directly would throw
      // on the other shape — and an error in a rule is a denial.
      allow create, update: if isNewOrgRow(request.resource.data)
        ? isFounder()
        : isAdminOf(request.resource.data.orgId);
      allow delete: if isOwnEmailKey() ||
        (isNewOrgRow(resource.data) ? isFounder() : isAdminOf(resource.data.orgId));
    }

    // Org rules
    match /orgs/{orgId} {

      // Helper: is the requesting user a member of this org?
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
      }

      // Helper: get the requesting user's role
      function memberRole() {
        return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role;
      }

      function isAdmin() { return isMember() && memberRole() == 'admin'; }
      function isEmployee() { return isMember() && memberRole() == 'employee'; }
      function isCustomer() { return isMember() && memberRole() == 'customer'; }
      // Bookkeeper: reads everything, writes nothing (no write rule ever includes it)
      function isBookkeeper() { return isMember() && memberRole() == 'bookkeeper'; }

      // Helper: the requester's pending invite doc (inviteLookup keyed by email,
      // lowercased with dots replaced by commas). Only admins write join rows and
      // only the founder writes newOrg rows, so this is trusted.
      // DECLARED HERE, above the allow statements that use it — the org-doc
      // create rule below calls it, and a rules function has to exist before the
      // rule that references it.
      function inviteFor() {
        return get(/databases/$(database)/documents/inviteLookup/$(request.auth.token.email.lower().replace('\\.', ',')));
      }

      // Org doc — still no self-signup: the ONLY way to create an org is to be
      // holding a founder invite. Members can read, admins can update.
      // (To open this up to anyone, change create to: if request.auth != null —
      // see "Enabling self-signup" in HANDOFF.md.)
      allow read: if isMember();
      // Pinned to the id the invite named, and only while the invite is live.
      // Without the id check a single invite could mint unlimited orgs before it
      // was consumed; without the time check a forgotten invite stays a live key
      // to a new company forever. Both defaults ('' and 0) fail closed.
      allow create: if request.auth != null &&
        request.auth.token.email != null &&
        inviteFor().data.get('kind', '') == 'newOrg' &&
        orgId == inviteFor().data.get('newOrgId', '') &&
        request.time.toMillis() < inviteFor().data.get('expiresAt', 0) &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();

      // Members subcollection
      match /members/{memberId} {
        allow read: if isMember() || request.auth.uid == memberId;
        // Admins manage members freely
        allow write: if isAdmin();
        // A user may create ONLY their own member doc, ONLY with a pending invite
        // for this org, and ONLY with the role the admin chose in that invite.
        allow create: if request.auth != null &&
          request.auth.uid == memberId &&
          request.auth.token.email != null &&
          inviteFor().data.get('orgId', '') == orgId &&
          request.resource.data.role == inviteFor().data.get('role', '');
        // Founding a new company: the holder of a founder invite may make
        // themselves ADMIN of the org they are creating in the same batch.
        // Same two guards as the org doc above — the org must be the exact one
        // the invite named, and the invite must not have expired — so an invite
        // buys exactly one org, once, within its window.
        allow create: if request.auth != null &&
          request.auth.uid == memberId &&
          request.auth.token.email != null &&
          inviteFor().data.get('kind', '') == 'newOrg' &&
          orgId == inviteFor().data.get('newOrgId', '') &&
          request.time.toMillis() < inviteFor().data.get('expiresAt', 0) &&
          request.resource.data.role == 'admin';
      }

      // Invites subcollection — admin only, except the invited user may
      // delete their own invite doc while accepting it at sign-in
      // (doc ID = email lowercased with dots replaced by commas).
      match /invites/{inviteId} {
        allow read, create, update: if isAdmin();
        allow delete: if isAdmin() ||
          (request.auth != null && request.auth.token.email != null &&
           inviteId == request.auth.token.email.lower().replace('\\.', ','));
      }

      // Settings — members can read, only admins can write
      match /settings/{doc} {
        allow read: if isMember();
        allow write: if isAdmin();
      }

      // ---- Calendar jobs ----
      // Scheduled by Time Logger NAME (employeeNames), but permissions run on
      // employeeUids — a name string means nothing to the server. The app
      // derives uids from the name→account links in settings; a name with no
      // linked account simply can't be filtered by, so that person sees no
      // calendar (they schedule fine, they just aren't an app user).
      // Customers work the same way: customerUids is derived from the
      // customer->account links in settings, so a customer sees the jobs
      // booked for them and nothing else.
      match /jobs/{jobId} {
        allow read: if isAdmin() || isBookkeeper();
        allow read: if isEmployee() &&
          ('employeeUids' in resource.data) &&
          request.auth.uid in resource.data.employeeUids;
        allow read: if isCustomer() &&
          ('customerUids' in resource.data) &&
          request.auth.uid in resource.data.customerUids;
        allow create, update, delete: if isAdmin();
      }

      // ---- Time logs (hours actually worked) ----
      // A job is a PLAN, a timelog is a FACT — separate collections so that
      // deleting a cancelled job can never touch recorded hours, and so an
      // employee could later be allowed to log their own time without gaining
      // any power over the schedule. One document per PERSON per line of work.
      // Same uid-not-name rule as jobs.
      match /timelogs/{logId} {
        allow read: if isAdmin() || isBookkeeper();
        allow read: if isEmployee() &&
          ('employeeUids' in resource.data) &&
          request.auth.uid in resource.data.employeeUids;
        allow create, update, delete: if isAdmin();
      }

      // ---- Price table ----
      // priceMeta/config holds the vendor columns and the share list.
      // Each row (item) is its own doc in priceItems, so a price edit rewrites
      // only that row and two people on different rows can't clobber each other.
      // Access: admin full; bookkeeper read-only (as everywhere); employee full
      // read/write ONLY when their uid is in priceMeta/config.sharedWith;
      // customer role has no access at all.
      function priceSharedWith() {
        return get(/databases/$(database)/documents/orgs/$(orgId)/priceMeta/config).data.sharedWith;
      }
      function isPriceSharedEmployee() {
        return isEmployee() &&
          exists(/databases/$(database)/documents/orgs/$(orgId)/priceMeta/config) &&
          ('sharedWith' in get(/databases/$(database)/documents/orgs/$(orgId)/priceMeta/config).data) &&
          request.auth.uid in priceSharedWith();
      }
      match /priceMeta/{doc} {
        allow read: if isAdmin() || isBookkeeper() || isEmployee();
        // Only an admin may change who the table is shared with
        allow write: if isAdmin();
      }
      match /priceItems/{itemId} {
        allow read: if isAdmin() || isBookkeeper() || isPriceSharedEmployee();
        allow create, update, delete: if isAdmin() || isPriceSharedEmployee();
      }

      // Customers — admin (write) and bookkeeper (read-only)
      match /customers/{customerId} {
        allow read: if isAdmin() || isBookkeeper();
        allow write: if isAdmin();
      }

      // Notes
      match /notes/{noteId} {
        // Admin and bookkeeper see everything
        allow read: if isAdmin() || isBookkeeper();
        // Employee and customer can only read if explicitly assigned
        allow read: if (isEmployee() || isCustomer()) &&
          ('assignedTo' in resource.data) &&
          request.auth.uid in resource.data.assignedTo;
        // Admin can create/update/delete anything
        allow create, update, delete: if isAdmin();
        // Employee can create GENERAL notes only (no customerId), self-assigned
        allow create: if isEmployee() &&
          request.resource.data.customerId == null &&
          request.resource.data.assignedTo is list &&
          request.auth.uid in request.resource.data.assignedTo;
        // Employee can update notes assigned to them, but not change the assignment
        allow update: if isEmployee() &&
          ('assignedTo' in resource.data) &&
          request.auth.uid in resource.data.assignedTo &&
          request.resource.data.assignedTo == resource.data.assignedTo;
        // Employees and customers can never delete
      }
    }
  }
}
